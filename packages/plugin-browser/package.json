{
  "name": "@moxxy/plugin-browser",
  "version": "0.37.2",
  "description": "Web capabilities for moxxy: search, fetch, and a shared native/Playwright browser computer-use session.",
  "keywords": [
    "moxxy",
    "agent",
    "browser",
    "playwright",
    "tools"
  ],
  "homepage": "https://moxxy.ai",
  "bugs": {
    "url": "https://github.com/moxxy-ai/moxxy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moxxy-ai/moxxy.git",
    "directory": "packages/plugin-browser"
  },
  "author": "Michal Makowski <michal.makowski97@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ssrf-guard": {
      "types": "./dist/ssrf-guard.d.ts",
      "import": "./dist/ssrf-guard.js"
    },
    "./browser-action": {
      "types": "./dist/browser-action.d.ts",
      "import": "./dist/browser-action.js"
    },
    "./browser-observation": {
      "types": "./dist/browser-observation.d.ts",
      "import": "./dist/browser-observation.js"
    },
    "./browser-errors": {
      "types": "./dist/browser-errors.d.ts",
      "import": "./dist/browser-errors.js"
    }
  },
  "bin": {
    "moxxy-browser-sidecar": "./dist/sidecar.js"
  },
  "files": [
    "dist",
    "src",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/sidecar.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "moxxy": {
    "plugin": {
      "entry": "./dist/index.js",
      "skills": "./skills"
    }
  },
  "dependencies": {
    "@moxxy/sdk": "workspace:*",
    "undici": "^6.28.0",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "playwright": "^1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@moxxy/tsconfig": "workspace:*",
    "@moxxy/vitest-preset": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
