{
  "name": "@moxxy/jev",
  "version": "0.2.0",
  "description": "TypeSafe's Jev for moxxy's step runners: the System One client, a window's accessibility elements as Jev reads them, grounding a described target in them, and per-app memory of what worked. Shared by Computer Use and the desktop browser.",
  "keywords": [
    "moxxy",
    "typesafe",
    "jev",
    "accessibility",
    "agent"
  ],
  "homepage": "https://moxxy.ai",
  "bugs": {
    "url": "https://github.com/moxxy-ai/moxxy/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moxxy-ai/moxxy.git",
    "directory": "packages/jev"
  },
  "author": "Michal Makowski <michal.makowski97@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@moxxy/sdk": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@moxxy/tsconfig": "workspace:*",
    "@moxxy/vitest-preset": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
